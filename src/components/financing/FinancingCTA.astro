---
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  compact?: boolean;
}

const {
  title = 'Need Financing Support?',
  subtitle = 'Compare deposit, daily, and weekly options, then request a callback from Nakaja Bikes.',
  ctaText = 'Request Financing',
  ctaHref = '/contact',
  compact = false,
} = Astro.props;
---
<section class:list={['card bg-surface-container border border-metal/20', compact ? 'p-6' : 'p-8 md:p-10']}>
  <h3 class="text-2xl md:text-3xl font-display font-bold text-white uppercase mb-3">{title}</h3>
  <p class="text-secondary font-body mb-6">{subtitle}</p>
  <a href={ctaHref} class="btn-primary">{ctaText}</a>
  <p class="text-secondary font-mono text-xs mt-6">
    Rates and approval are subject to financing partner terms. Confirm current offer with Nakaja Bikes.
  </p>
</section>
