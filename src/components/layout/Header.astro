---
import dealer from '../../data/dealer.json';
import { mainNavigation } from '../../data/navigation/main';
import { buildWhatsAppUrl, publicMessengerLink } from '../../lib/contact';

const whatsappMessage = 'Hi Nakaja Bikes, I want to book on WhatsApp and ask about available UM motorcycles.';
const whatsappUrl = buildWhatsAppUrl(whatsappMessage);
const pathname = Astro.url.pathname;
const isCurrentPath = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const navLinkClass = (href: string) =>
  [
    'text-on-surface hover:text-white font-mono text-sm uppercase tracking-wider transition-colors',
    isCurrentPath(href) ? 'text-white' : '',
  ].join(' ');
---
<header class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-metal/20" data-site-header>
  <div class="max-w-[1280px] mx-auto px-4 md:px-6 h-20 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${dealer.dealer} home`}>
      <img src="/logo_nakaja.png" alt="Nakaja Bikes logo" class="h-11 w-11 md:h-12 md:w-12 object-contain" width="48" height="48" />
      <span class="text-lg md:text-2xl font-display font-bold text-white tracking-tight uppercase">
        {dealer.dealer.split(' ')[0]}<span class="text-primary-container">{dealer.dealer.split(' ')[1] || ''}</span>
      </span>
    </a>

    <nav class="hidden lg:flex gap-8" aria-label="Primary navigation">
      {mainNavigation.map((item) => (
        <a href={item.href} aria-current={isCurrentPath(item.href) ? 'page' : undefined} class={navLinkClass(item.href)}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href={publicMessengerLink} target="_blank" rel="noopener noreferrer" class="btn-secondary text-xs px-4 py-3 uppercase tracking-widest" aria-label="Open Nakaja Bikes Messenger chat">Messenger</a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs px-5 py-3 bg-[#25D366] hover:bg-[#1EBE5A] hover:border-transparent text-white uppercase tracking-widest" aria-label="Open Nakaja Bikes WhatsApp chat">WhatsApp</a>
    </div>

    <div class="flex lg:hidden items-center gap-2">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-white px-3 py-2 font-mono text-[10px] uppercase tracking-widest sm:px-4 sm:py-3" aria-label="Open Nakaja Bikes WhatsApp chat">WhatsApp</a>
      <button
        type="button"
        class="group inline-flex h-10 w-10 items-center justify-center border border-metal/30 bg-black/40 text-white transition-colors hover:border-metal focus-visible:border-primary-container"
        aria-label="Open mobile navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <span class="relative block h-4 w-5" aria-hidden="true">
          <span class="absolute left-0 top-0 h-0.5 w-5 bg-current transition-transform duration-200 group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
          <span class="absolute left-0 top-[7px] h-0.5 w-5 bg-current transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
          <span class="absolute left-0 top-[14px] h-0.5 w-5 bg-current transition-transform duration-200 group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-navigation"
    class="hidden lg:hidden border-t border-metal/20 bg-[#0e0e0e]/98 shadow-2xl shadow-black/40"
    data-mobile-menu
  >
    <nav class="max-w-[1280px] mx-auto px-4 py-5" aria-label="Mobile navigation">
      <ul class="divide-y divide-metal/15 border-y border-metal/15">
        {mainNavigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentPath(item.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-14 items-center justify-between py-4 font-display text-lg font-bold uppercase tracking-wide transition-colors',
                isCurrentPath(item.href) ? 'text-white' : 'text-secondary hover:text-white',
              ]}
              data-mobile-menu-link
            >
              <span>{item.label}</span>
              <span class="font-mono text-xs text-primary-container" aria-hidden="true">Open</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-5">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary min-h-12 bg-[#25D366] text-sm uppercase tracking-widest text-white hover:bg-[#1EBE5A] hover:border-transparent" aria-label="Open Nakaja Bikes WhatsApp chat" data-mobile-menu-link>WhatsApp</a>
        <a href={publicMessengerLink} target="_blank" rel="noopener noreferrer" class="btn-secondary min-h-12 text-sm uppercase tracking-widest" aria-label="Open Nakaja Bikes Messenger chat" data-mobile-menu-link>Messenger</a>
      </div>

      <p class="mt-5 border-l-2 border-primary-container pl-4 font-mono text-xs leading-relaxed text-secondary">
        {dealer.location}
      </p>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const menu = header?.querySelector('[data-mobile-menu]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const links = header?.querySelectorAll('[data-mobile-menu-link]');

  const setMenuOpen = (open: boolean) => {
    if (!menu || !toggle) return;

    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close mobile navigation menu' : 'Open mobile navigation menu');
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  links?.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1024px)').matches) setMenuOpen(false);
  });
</script>
