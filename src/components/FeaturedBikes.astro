---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { buildWhatsAppUrl } from '../lib/contact';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;
const [primary, ...secondaryProducts] = products;

const whatsappUrl = (text: string) => buildWhatsAppUrl(text);
---

{primary && (
  <section class="max-w-[1280px] mx-auto px-6 py-20 md:py-24">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <span class="block font-mono text-xs text-primary-container uppercase tracking-[0.35em] mb-4">Featured Bikes</span>
        <h2 class="text-4xl md:text-5xl font-display font-bold text-white uppercase mb-4">Ready for Work</h2>
        <div class="w-24 h-1 bg-primary-container"></div>
      </div>
      <a href="/motorcycles" class="btn-secondary text-xs px-5 py-3 uppercase tracking-widest self-start md:self-auto">View All Bikes</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.25fr_0.75fr] gap-8">
      <article class="relative min-h-[620px] overflow-hidden border border-metal/20 bg-surface-container group">
        <div class="absolute inset-0 opacity-70">
          {primary.data.heroImage ? (
            <Image
              src={primary.data.heroImage}
              alt={primary.data.title}
              class="w-full h-full object-contain object-center p-8 md:p-12 transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-secondary font-mono text-sm">Image Coming Soon</div>
          )}
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent"></div>
        <div class="relative z-10 min-h-[620px] flex flex-col justify-between p-7 md:p-10">
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-[11px] uppercase tracking-[0.28em] text-primary-container">{primary.data.featuredLabel ?? 'Featured'}</span>
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-secondary">{primary.data.engine}</span>
          </div>

          <div class="max-w-2xl">
            <h3 class="text-4xl md:text-6xl font-display font-black text-white uppercase tracking-tight mb-5">{primary.data.title}</h3>
            <p class="text-lg md:text-xl text-secondary leading-relaxed max-w-xl mb-8">{primary.data.excerpt}</p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-5 border-y border-metal/20 py-6 mb-8">
              <div>
                <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Cash</span>
                <span class="block font-display text-2xl text-primary-container font-black">KSh {primary.data.cashPrice.toLocaleString()}</span>
              </div>
              <div>
                <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Deposit</span>
                <span class="block font-mono text-sm text-white font-bold">KSh {primary.data.deposit.toLocaleString()}</span>
              </div>
              <div>
                <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Power</span>
                <span class="block font-mono text-sm text-white font-bold">{primary.data.power}</span>
              </div>
              <div>
                <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Load</span>
                <span class="block font-mono text-sm text-white font-bold">{primary.data.maxLoad}</span>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`/motorcycles/${primary.data.slug ?? primary.id}`} class="btn-primary text-xs px-6 py-4 uppercase tracking-widest">View Specs</a>
              <a href={whatsappUrl(primary.data.whatsappText)} target="_blank" rel="noopener noreferrer" class="btn-secondary text-xs px-6 py-4 uppercase tracking-widest">Ask on WhatsApp</a>
            </div>
          </div>
        </div>
      </article>

      <div class="grid grid-cols-1 gap-8">
        {secondaryProducts.map(product => (
          <article class="grid grid-cols-1 sm:grid-cols-[0.9fr_1.1fr] min-h-[294px] overflow-hidden border border-metal/20 bg-black/30 group">
            <div class="relative min-h-[210px] sm:min-h-0 bg-surface-container">
              {product.data.heroImage ? (
                <Image
                  src={product.data.heroImage}
                  alt={product.data.title}
                  class="absolute inset-0 w-full h-full object-contain p-5 transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center text-secondary font-mono text-xs">Image Coming Soon</div>
              )}
            </div>
            <div class="p-6 flex flex-col justify-between">
              <div>
                <span class="block font-mono text-[10px] uppercase tracking-[0.25em] text-primary-container mb-3">{product.data.featuredLabel ?? 'Featured'}</span>
                <h3 class="text-2xl md:text-3xl font-display font-bold text-white uppercase leading-none mb-4">{product.data.title}</h3>
                <p class="text-sm text-secondary leading-relaxed line-clamp-3">{product.data.excerpt}</p>
              </div>

              <div>
                <div class="grid grid-cols-2 gap-4 border-y border-metal/20 py-4 my-5">
                  <div>
                    <span class="block font-mono text-[9px] text-secondary uppercase tracking-widest mb-1.5">Engine</span>
                    <span class="block font-mono text-xs text-white font-bold">{product.data.engine}</span>
                  </div>
                  <div>
                    <span class="block font-mono text-[9px] text-secondary uppercase tracking-widest mb-1.5">Cash</span>
                    <span class="block font-display text-lg text-primary-container font-black">KSh {product.data.cashPrice.toLocaleString()}</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <a href={`/motorcycles/${product.data.slug ?? product.id}`} class="btn-secondary text-[10px] px-3 py-3 uppercase tracking-widest">Specs</a>
                  <a href={whatsappUrl(product.data.whatsappText)} target="_blank" rel="noopener noreferrer" class="btn-primary text-[10px] px-3 py-3 uppercase tracking-widest">WhatsApp</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
