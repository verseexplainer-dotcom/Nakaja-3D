---
import HeroShowroom from './HeroShowroom.astro';

interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---
<HeroShowroom
  title={title}
  subtitle={subtitle}
  actions={[
    { label: ctaText ?? 'Explore Models', href: ctaLink ?? '/motorcycles', variant: 'primary' },
  ]}
/>
