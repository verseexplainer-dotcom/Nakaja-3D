---
import type { ImageMetadata } from 'astro';

interface Props {
  modelPath?: string;
  posterImage?: ImageMetadata;
  title?: string;
}

const { modelPath, posterImage, title = '3D Model Viewer' } = Astro.props;
const hasModel = Boolean(modelPath);
---
<section class="card bg-surface-container border border-metal/20 overflow-hidden">
  {hasModel ? (
    <>
      <script is:inline type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
      <model-viewer
        src={modelPath}
        poster={posterImage?.src}
        alt={title}
        camera-controls
        auto-rotate
        loading="lazy"
        reveal="interaction"
        class="w-full h-[420px] bg-black/30"
      ></model-viewer>
      <p class="px-5 py-4 border-t border-metal/20 text-secondary font-mono text-xs">
        3D preview loads only for this model. Use the static image if your device is on a weak connection.
      </p>
    </>
  ) : (
    <div class="relative aspect-[16/10] bg-black/30 flex items-center justify-center">
      {posterImage ? (
        <img src={posterImage.src} alt={`${title} static product view`} class="w-full h-full object-contain p-6 md:p-10" width={posterImage.width} height={posterImage.height} loading="eager" decoding="async" />
      ) : (
        <div class="px-6 text-center text-secondary font-mono text-sm">Static product image coming soon.</div>
      )}
      <div class="absolute left-4 top-4 bg-black/70 border border-metal/20 px-3 py-2 text-[10px] font-mono uppercase tracking-widest text-secondary">
        3D model pending
      </div>
    </div>
  )}
</section>
