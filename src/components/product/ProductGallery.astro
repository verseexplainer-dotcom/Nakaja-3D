---
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  title: string;
}

const { images = [], title } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {images.length > 0 ? images.map((img, index) => (
    <figure class:list={[
      'card overflow-hidden bg-surface-container',
      index === 0 ? 'md:col-span-2 aspect-[16/9]' : 'aspect-[4/3]',
    ]}>
      <img src={img.src} alt={`${title} view ${index + 1}`} class="w-full h-full object-contain p-4 md:p-6 hover:scale-105 transition-transform duration-700 motion-reduce:transform-none" width={img.width} height={img.height} loading="lazy" decoding="async" />
    </figure>
  )) : (
    <div class="card overflow-hidden bg-surface-container aspect-[4/3] flex items-center justify-center col-span-full">
      <p class="text-secondary font-mono text-sm">No images available</p>
    </div>
  )}
</div>
