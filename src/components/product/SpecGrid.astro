---
interface SpecItem {
  label: string;
  value: string | number | null | undefined;
  emphasis?: boolean;
}

interface Props {
  specs: SpecItem[];
}

const { specs } = Astro.props;
const visibleSpecs = specs.filter((spec) => spec.value !== null && spec.value !== undefined && String(spec.value).trim() !== '');
---
<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-metal/20 border border-metal/20">
  {visibleSpecs.map((spec) => (
    <div class="bg-surface-container p-5 md:p-6">
      <span class="block text-[10px] uppercase font-mono tracking-widest text-secondary mb-2">{spec.label}</span>
      <span class:list={[
        'block font-mono leading-snug',
        spec.emphasis ? 'text-primary-container text-lg font-bold' : 'text-white text-sm md:text-base',
      ]}>
        {spec.value}
      </span>
    </div>
  ))}
</div>

