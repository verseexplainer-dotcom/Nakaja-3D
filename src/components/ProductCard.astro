---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { buildWhatsAppUrl } from '../lib/contact';

interface Props {
  product: CollectionEntry<'products'>;
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const { title, excerpt, cashPrice, deposit, engine, heroImage, whatsappText, featuredLabel } = product.data;
const productSlug = product.data.slug ?? product.id;
const whatsappUrl = buildWhatsAppUrl(whatsappText);
---
<article class="card flex flex-col h-full group overflow-hidden bg-surface-container/70">
  <a href={`/motorcycles/${productSlug}`} class="relative w-full aspect-[3/2] overflow-hidden bg-black/30" aria-label={`View details for ${title}`}>
    {heroImage ? (
      <Image src={heroImage} alt={`${title} product photo`} class="w-full h-full object-contain p-5 group-hover:scale-105 transition-transform duration-700 motion-reduce:transform-none" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-secondary font-mono text-sm">Image Coming Soon</div>
    )}
    {featuredLabel && (
      <span class="absolute left-4 top-4 bg-primary-container text-white font-mono text-[10px] uppercase tracking-widest px-3 py-2">
        {featuredLabel}
      </span>
    )}
  </a>

  <div class:list={['flex-grow flex flex-col', compact ? 'p-5' : 'p-6 md:p-8']}>
    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-primary-container mb-3">UM Motorbikes</p>
    <h3 class:list={['font-display font-bold text-white uppercase tracking-tight', compact ? 'text-2xl mb-2' : 'text-3xl mb-3']}>{title}</h3>
    <p class="text-secondary font-body mb-6 line-clamp-3 leading-relaxed">{excerpt}</p>

    <div class="grid grid-cols-2 gap-4 mb-4 border-y border-metal/20 py-5">
      <div>
        <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-1.5 opacity-70">Engine</span>
        <span class="block font-mono text-sm text-white font-bold">{engine}</span>
      </div>
      <div>
        <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-1.5 opacity-70">Cash Price</span>
        <span class="block font-display text-xl text-primary-container font-black">KSh {cashPrice.toLocaleString()}</span>
      </div>
      <div class="col-span-2">
        <span class="block font-mono text-[10px] text-secondary uppercase tracking-widest mb-1.5 opacity-70">Deposit</span>
        <span class="block font-mono text-sm text-white font-bold">{deposit > 0 ? `From KSh ${deposit.toLocaleString()}` : 'Confirm with Nakaja'}</span>
      </div>
    </div>

    <p class="text-secondary font-mono text-[11px] mb-6">Rates and approval are subject to financing partner terms. Confirm current offer with Nakaja Bikes.</p>

    <div class="mt-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href={`/motorcycles/${productSlug}`} class="btn-secondary text-xs px-4 py-4 font-bold uppercase tracking-widest">View Details</a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs px-4 py-4 bg-[#25D366] hover:bg-[#1EBE5A] hover:border-transparent text-white font-bold uppercase tracking-widest" aria-label={`Ask about ${title} on WhatsApp`}>WhatsApp Us</a>
    </div>
  </div>
</article>
