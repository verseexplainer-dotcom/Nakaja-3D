---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="About Nakaja Bikes"
  description="Learn about Nakaja Bikes, an authorized UM Motorbikes dealer serving Nairobi riders from the Industrial Area showroom."
  canonicalPath="/about"
>
  <section class="max-w-[960px] mx-auto px-6 py-28 md:py-32">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary-container mb-4">About Nakaja</p>
    <h1 class="text-4xl md:text-6xl font-display font-black text-white uppercase mb-6">Built For Riders Who Move Daily</h1>
    <p class="text-secondary text-lg leading-relaxed mb-6">Nakaja Bikes is an authorized UM Motorbikes dealer in Nairobi, focused on practical motorcycles, clear financing conversations, and fast rider support.</p>
    <p class="text-secondary leading-relaxed">Visit the Industrial Area showroom, compare available models, and talk to the team on WhatsApp or Messenger when you are ready to move.</p>
  </section>
</Layout>
