---
import Layout from '../layouts/Layout.astro';
import FinanceCards from '../components/financing/FinanceCards.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const ndume = products.find((product) => product.id === 'duty-max-xl-150');
const xl125 = products.find((product) => product.id === 'duty-max-xl-125');
---
<Layout
  title="Financing | Nakaja Bikes Nairobi"
  description="Review Nakaja Bikes financing examples for UM motorcycles in Nairobi, including listed deposits and repayment plans. Confirm current partner terms before purchase."
  canonicalPath="/financing/"
>
  <div class="max-w-[1280px] mx-auto px-6 py-12 md:py-24">
    <p class="font-mono text-xs uppercase tracking-[0.28em] text-primary-container mb-5">Financing Support</p>
    <h1 class="text-5xl md:text-7xl font-display font-bold text-white uppercase mb-6 tracking-tighter">Financing Plans</h1>
    <div class="w-24 h-1 bg-primary-container mb-12"></div>

    <div class="prose prose-invert max-w-[800px] mb-16 text-secondary font-body text-lg">
      <p>Review the listed cash, deposit, and repayment examples, then confirm the current partner offer with Nakaja Bikes before you commit.</p>
      <p>Requirements and approval remain subject to the financing partner handling your application.</p>
    </div>

    <div class="mb-20">
      <h2 class="text-3xl font-display font-bold text-white uppercase mb-8">Example: {ndume?.data.title}</h2>
      {ndume && (
        <FinanceCards
          cashPrice={ndume.data.cashPrice}
          deposit={ndume.data.deposit}
          watuDeposit={ndume.data.watuDeposit}
          watuPlan={ndume.data.watuPlan}
          fortunePlan={ndume.data.fortunePlan}
        />
      )}
    </div>

    <div class="mb-20">
      <h2 class="text-3xl font-display font-bold text-white uppercase mb-8">Example: {xl125?.data.title}</h2>
      {xl125 && (
        <FinanceCards
          cashPrice={xl125.data.cashPrice}
          deposit={xl125.data.deposit}
          watuDeposit={xl125.data.watuDeposit}
          watuPlan={xl125.data.watuPlan}
          fortunePlan={xl125.data.fortunePlan}
        />
      )}
    </div>

    <section class="card p-8 bg-surface-container border border-metal/20" aria-labelledby="finance-requirements-heading">
      <h2 id="finance-requirements-heading" class="text-2xl font-display font-bold text-white uppercase mb-6">Requirements</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-secondary font-mono text-sm">
        <li class="flex items-center gap-3"><span class="text-primary-container text-lg font-bold">✓</span> Original National ID</li>
        <li class="flex items-center gap-3"><span class="text-primary-container text-lg font-bold">✓</span> KRA PIN Certificate</li>
        <li class="flex items-center gap-3"><span class="text-primary-container text-lg font-bold">✓</span> 2 Guarantors with IDs</li>
        <li class="flex items-center gap-3"><span class="text-primary-container text-lg font-bold">✓</span> M-Pesa Statement (6 months)</li>
        <li class="flex items-center gap-3"><span class="text-primary-container text-lg font-bold">✓</span> Initial Deposit</li>
      </ul>
    </section>
  </div>
</Layout>
